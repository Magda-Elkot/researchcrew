# Copy to .env and fill in real values. Never commit .env.

# LiteLLM model string used by the agents (provider/model).
# Groq retired Llama 3.3 70B; gpt-oss-120b is its replacement here (DECISIONS #67).
LLM_MODEL=groq/openai/gpt-oss-120b

# Groq API key (free tier: https://console.groq.com). Required from Phase 3.
GROQ_API_KEY=your-groq-api-key-here

# Tavily API key for web search through Tavily's hosted MCP server
# (free tier, no card: https://tavily.com). Required from Phase 3.
TAVILY_API_KEY=your-tavily-api-key-here

# Qdrant URL. docker-compose overrides this to http://qdrant:6333 for the api container.
QDRANT_URL=http://localhost:6333

# Qdrant collection that holds the indexed PDF chunks.
QDRANT_COLLECTION=documents

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# App version reported by /health and used to tag traces.
APP_VERSION=0.1.0

# --- docs-mcp ---
# Embedding model (Hugging Face id) and its vector size; they must match the Qdrant collection.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Chunking, counted in model tokens. CHUNK_OVERLAP must be smaller than CHUNK_TOKENS.
CHUNK_TOKENS=800
CHUNK_OVERLAP=100

# Where the embedding model is downloaded (~2.3 GB). Leave empty for ~/.cache/huggingface.
MODEL_CACHE_DIR=

# CPU threads used for embedding. Lower = slower ingest but the machine stays responsive.
# 0 = use all cores. (Empty also means the default, 4.)
EMBEDDING_THREADS=4

# docs-mcp server address. Use 0.0.0.0 inside Docker.
DOCS_MCP_HOST=127.0.0.1
DOCS_MCP_PORT=8001

# Host ports published by docker-compose (change if already in use on your machine).
API_HOST_PORT=8000
QDRANT_HOST_PORT=6333
DOCS_MCP_HOST_PORT=8001
FRONTEND_HOST_PORT=8501

# docker-compose only: reuse an existing Hugging Face hub cache for the docs-mcp container
# (e.g. /home/<you>/.cache/huggingface/hub). Empty = a named volume (downloads bge-m3 once).
MODEL_CACHE_HOST_DIR=
# Set to 1 together with MODEL_CACHE_HOST_DIR so the container never tries to download.
HF_HUB_OFFLINE=0

# --- MCP clients used by the agents (Phase 3) ---
# Tavily's hosted MCP endpoint. The key above is sent in an Authorization header, not in this URL.
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# Where the agents reach docs-mcp (streamable HTTP endpoint).
DOCS_MCP_URL=http://127.0.0.1:8001/mcp
# The only folder the filesystem MCP server may read (read-only).
NOTES_DIR=data/notes
# Pinned npm package for the filesystem MCP server, started with npx.
FILESYSTEM_MCP_PACKAGE=@modelcontextprotocol/server-filesystem@2.3.0
# How to start it: npx (downloads the pinned package once) or an installed command.
FILESYSTEM_MCP_COMMAND=npx
# Seconds to wait for an MCP server to connect.
MCP_CONNECT_TIMEOUT=30
# Size limits on tool results sent to the LLM (Groq free tier: 8K tokens per minute).
# Hits per document search; characters of text per hit; characters per whole tool result.
MCP_SEARCH_TOP_K=3
MCP_MAX_ITEM_CHARS=1200
MCP_MAX_RESULT_CHARS=6000

# --- Crew runs (Phase 3b) ---
# LLM sampling temperature (low = more consistent reports).
LLM_TEMPERATURE=0.2
# Your provider's tokens-per-minute limit (Groq free tier: 8000). Calls are paced to stay
# below it instead of failing on rate limits. 0 = no pacing (paid tiers).
LLM_TOKENS_PER_MINUTE=8000
# Seconds before one LLM request is abandoned, and how many times it is retried at once
# (dropped connections/timeouts; rate limits are retried separately, with the provider's wait).
LLM_TIMEOUT_S=90
LLM_NUM_RETRIES=1
# Longest wait on a provider's retry-after hint, in seconds (a daily limit fails fast instead).
LLM_MAX_RETRY_WAIT_S=60
# Per-run limits (SPEC): seconds before a run stops, and tool calls per run.
RUN_TIMEOUT_S=900
MAX_TOOL_CALLS=25
# Folder where the CLI writes <id>.json and <id>.md reports.
OUTPUTS_DIR=outputs

# --- API jobs and frontend (Phase 4) ---
# SQLite file for jobs, results and progress events (created on first start).
JOBS_DB_PATH=var/jobs.db
# Research runs at the same time; keep 1 on free tiers (they share one tokens-per-minute limit).
MAX_CONCURRENT_JOBS=1
# How often the progress stream (SSE) checks for new events, in seconds.
SSE_POLL_INTERVAL_S=0.5
# Extra seconds after RUN_TIMEOUT_S before a still-running job is marked failed.
JOB_TIMEOUT_GRACE_S=60
# Where the Streamlit page reaches the API (docker-compose sets http://api:8000).
API_URL=http://127.0.0.1:8000

# --- Tracing with self-hosted Langfuse (Phase 5) ---
# The app's Langfuse keys and URL. Empty keys = tracing off (runs work the same, untraced).
# `make langfuse-env` fills both keys with the self-hosted project's keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Local runs: http://localhost:3000 (docker-compose sets http://langfuse-web:3000 for the api).
LANGFUSE_BASE_URL=http://localhost:3000
# Where you open Langfuse in the browser; used for the trace links (trace_url) the API returns.
LANGFUSE_UI_URL=http://localhost:3000
# Shown on traces, e.g. "dev" or "eval".
LANGFUSE_TRACING_ENVIRONMENT=dev
# Host port of the Langfuse UI (docker-compose, profile "observability").
LANGFUSE_HOST_PORT=3000
# Secrets of the self-hosted Langfuse services. Leave empty here: `make langfuse-env` appends
# long random values to your .env (only for the missing ones) and never prints them.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex characters (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
# Headless init: Langfuse creates this organisation, project, API key pair and first user at
# its first start (log in at the UI with this email and password; both in your .env).
LANGFUSE_INIT_ORG_ID=researchcrew
LANGFUSE_INIT_PROJECT_ID=researchcrew
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@researchcrew.local
LANGFUSE_INIT_USER_PASSWORD=

# --- Evaluation (Phase 6) ---
# The LLM judge (a different provider from the generator): free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# LiteLLM model name of the judge; pinned so every eval run is scored by the same model.
JUDGE_MODEL=gemini/gemini-3.5-flash-lite
# Judge calls per minute (well inside the free tier; 429/503 answers also back off).
JUDGE_REQUESTS_PER_MINUTE=10
# Characters of raw tool output shown to the judge around each cited snippet.
JUDGE_CONTEXT_CHARS=1500
# Folder with dataset.jsonl, runs/ (per-run results) and results.md.
EVAL_DIR=evals

# CrewAI's own settings (read by CrewAI, not by app/config.py): no anonymous telemetry and
# no CrewAI-cloud tracing; our traces go to self-hosted Langfuse (DECISIONS #65).
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
